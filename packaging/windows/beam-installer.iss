; Script generated by Inno Setup Script Wizard for beaM.
#define MyAppName "beaM."
#define MyAppVersion "0.2.0"
#define MyAppPublisher "beaM. Contributors"
#define MyAppURL "https://mozcelik14.github.io/beaM/"
#define MyAppExeName "beam.exe"

[Setup]
AppId={{9F82A4B1-6D98-4E49-8084-7F8152D029A8}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\beaM
DisableProgramGroupPage=yes
LicenseFile=..\..\LICENSE
OutputDir=..\..\dist
OutputBaseFilename=beaM-v{#MyAppVersion}-windows-x86_64-setup
SetupIconFile=beam.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
UninstallDisplayIcon={app}\{#MyAppExeName}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "assoc_beam"; Description: "Associate .beam files with beaM."; GroupDescription: "File Associations:"; Flags: checkedonce
Name: "assoc_raw"; Description: "Associate camera RAW files with beaM."; GroupDescription: "File Associations:"; Flags: unchecked

[Files]
Source: "..\..\target\release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Associate .beam project files
Root: HKA; Subkey: "Software\Classes\.beam"; ValueType: string; ValueName: ""; ValueData: "beaM.Project"; Flags: uninsdeletevalue; Tasks: assoc_beam
Root: HKA; Subkey: "Software\Classes\beaM.Project"; ValueType: string; ValueName: ""; ValueData: "beaM. Project File"; Flags: uninsdeletekey; Tasks: assoc_beam
Root: HKA; Subkey: "Software\Classes\beaM.Project\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: assoc_beam
Root: HKA; Subkey: "Software\Classes\beaM.Project\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: assoc_beam

; Camera RAW associations (when selected)
Root: HKA; Subkey: "Software\Classes\.arw\OpenWithProgids"; ValueType: string; ValueName: "beaM.RawPhoto"; ValueData: ""; Flags: uninsdeletevalue; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\.cr2\OpenWithProgids"; ValueType: string; ValueName: "beaM.RawPhoto"; ValueData: ""; Flags: uninsdeletevalue; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\.cr3\OpenWithProgids"; ValueType: string; ValueName: "beaM.RawPhoto"; ValueData: ""; Flags: uninsdeletevalue; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\.nef\OpenWithProgids"; ValueType: string; ValueName: "beaM.RawPhoto"; ValueData: ""; Flags: uninsdeletevalue; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\.dng\OpenWithProgids"; ValueType: string; ValueName: "beaM.RawPhoto"; ValueData: ""; Flags: uninsdeletevalue; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\beaM.RawPhoto"; ValueType: string; ValueName: ""; ValueData: "Camera RAW Image"; Flags: uninsdeletekey; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\beaM.RawPhoto\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: assoc_raw
Root: HKA; Subkey: "Software\Classes\beaM.RawPhoto\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: assoc_raw

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
